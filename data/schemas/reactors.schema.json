{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reactors",
  "type": "object",
  "properties": {
    "_comment": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "shield",
              "weapon",
              "special",
              "reactor",
              "armor",
              "other"
            ]
          },
          "branch": {
            "type": "string"
          },
          "tier": {
            "type": "integer",
            "minimum": 1
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "x-ref": "tech"
            }
          },
          "excludes": {
            "type": "array",
            "items": {
              "type": "string",
              "x-ref": "tech"
            }
          },
          "icon": {
            "type": "string"
          },
          "output": {
            "type": "number",
            "minimum": 0
          },
          "capacitor": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "branch",
          "tier",
          "cost",
          "output",
          "capacitor"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
