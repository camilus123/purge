{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Economy",
  "type": "object",
  "properties": {
    "_comment": {
      "type": "string"
    },
    "starting_credits": {
      "type": "number",
      "minimum": 0
    },
    "sell_refund": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "starting_loadout": {
      "type": "object",
      "properties": {
        "reactor": {
          "type": "string",
          "x-ref": "tech"
        },
        "shield": {
          "type": "string",
          "x-ref": "tech"
        },
        "armor": {
          "type": "string",
          "x-ref": "tech"
        },
        "weapon1": {
          "type": "string",
          "x-ref": "tech"
        },
        "weapon2": {
          "type": "string",
          "x-ref": "tech"
        },
        "special": {
          "type": "string",
          "x-ref": "tech"
        }
      },
      "required": [
        "reactor",
        "armor"
      ],
      "additionalProperties": false
    },
    "repair_cost_per_hp": {
      "type": "number",
      "minimum": 0
    },
    "unlock_all_sets": {
      "type": "boolean"
    },
    "results": {
      "type": "object",
      "properties": {
        "kill_percent_bonus": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "accuracy_bonus_max": {
          "type": "number",
          "minimum": 0
        },
        "accuracy_bonus_min_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hull_bonus_max": {
          "type": "number",
          "minimum": 0
        },
        "no_hull_damage_bonus": {
          "type": "number",
          "minimum": 0
        },
        "boss_kill_bonus": {
          "type": "number",
          "minimum": 0
        },
        "boss_time_bonus_per_second": {
          "type": "number",
          "minimum": 0
        },
        "pickup_credit_mult": {
          "type": "number",
          "minimum": 0
        },
        "secret_bonus": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "starting_credits",
    "starting_loadout"
  ],
  "additionalProperties": false
}
