{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Power model",
  "type": "object",
  "properties": {
    "_comment": {
      "type": "string"
    },
    "default_shield_share": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "step": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 1
    },
    "shield_recharge_share_scale": {
      "type": "number",
      "minimum": 0
    },
    "reference_reactor_output": {
      "type": "number",
      "minimum": 1
    },
    "starved_fire_rate_mult": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "damage_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "default_shield_share",
    "step",
    "damage_types"
  ],
  "additionalProperties": false
}
