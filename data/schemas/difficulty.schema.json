{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Difficulty levels",
  "type": "object",
  "properties": {
    "_comment": {
      "type": "string"
    },
    "default": {
      "type": "string"
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "enemy_hp": {
            "type": "number",
            "minimum": 0.05
          },
          "enemy_damage": {
            "type": "number",
            "minimum": 0
          },
          "bullet_speed": {
            "type": "number",
            "minimum": 0.1
          },
          "fire_rate": {
            "type": "number",
            "minimum": 0.05
          },
          "credit_mult": {
            "type": "number",
            "minimum": 0
          },
          "starting_credits_mult": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "levels"
  ],
  "additionalProperties": false
}
