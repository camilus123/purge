; Engine configuration file. Pinned to Godot 4.7.2 (standard build).

config_version=5

[application]

config/name="purge"
config/description="Top-down vertical scrolling shooter"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0
boot_splash/bg_color=Color(0.02, 0.02, 0.04, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/core/settings.gd"
Data="*res://scripts/core/data_store.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[physics]

common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=16
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.04, 1)
